# Canonical origin. Required in production: metadata, sitemap, robots and
# JSON-LD are all built from it.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Any endpoint that accepts a JSON POST (Slack, Discord, Resend...).
# Unset, contact messages are written to the server log instead of forwarded.
CONTACT_WEBHOOK_URL=

# Optional. Requests per minute per IP against /api/contact. Defaults to 5.
CONTACT_RATE_LIMIT=
