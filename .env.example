# Canonical origin. Optional on Vercel: the build falls back to the project's
# production URL automatically. Set this once you have a custom domain.
#
# Deliberately not NEXT_PUBLIC_: this value is only read on the server, so it
# never needs to reach the browser. NEXT_PUBLIC_SITE_URL is still honoured if
# you already have it set.
SITE_URL=https://example.com

# Optional. Any endpoint that accepts a JSON POST (Slack, Discord, Resend...).
# Unset, contact messages are written to the server log instead of forwarded.
CONTACT_WEBHOOK_URL=

# Optional. Requests per minute per IP against /api/contact. Defaults to 5.
CONTACT_RATE_LIMIT=
